# Copy to .env and adjust. All values are optional.

# Administrator login (single account).
ADMIN_USERNAME=admin
# If unset, a random password is generated on first start and saved to
# DATA_DIR/.admin-password. Placeholders such as "change-me" are refused.
ADMIN_PASSWORD=

# Secret used to sign session cookies. If unset, one is generated and stored in DATA_DIR.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Public URL of the site, e.g. https://photos.example.com
# Only needed if your reverse proxy doesn't send X-Forwarded-Proto / X-Forwarded-Host.
# ORIGIN=https://photos.example.com

# Whose X-Forwarded-* headers to trust: auto (proxies on loopback/private networks),
# true (everyone; only if the port is reachable solely through your proxy) or false.
# TRUST_PROXY=auto

# Largest single upload request (default 512M). Photos and videos are sent in 8 MB pieces,
# so this only limits the hero image.
# BODY_SIZE_LIMIT=512M

# Folder that images can be imported from (default: DATA_DIR/import).
# IMPORT_DIR=/data/import

# User and group the app runs as inside the container (owner of ./data on the host).
# PUID=1000
# PGID=1000
