{
	"name": "client-gallery",
	"version": "0.0.1",
	"description": "Self-hosted photography portfolio and client gallery delivery.",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "UV_THREADPOOL_SIZE=16 node --disable-warning=ExperimentalWarning server.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@fontsource-variable/cormorant-garamond": "^5.3.0",
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"@fontsource-variable/source-sans-3": "^5.3.1",
		"@fontsource/cormorant-sc": "^5.3.0",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@lucide/svelte": "^1.70.0",
		"exifr": "^7.1.3",
		"marked": "^18.1.3",
		"pdfkit": "^0.20.2",
		"sharp": "^0.35.5",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26",
		"@types/pdfkit": "^0.17.7",
		"@types/yazl": "^3.3.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
